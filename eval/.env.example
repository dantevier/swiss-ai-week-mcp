# Copy to eval/.env and fill in. Never commit .env.
# Load in bash:        set -a; source .env; set +a
# Load in PowerShell:  Get-Content .env | Where-Object { $_ -match '^\s*[^#\s].*=' } | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }

# Providers (stage 1)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Swisscom myAI (stage 2)
MYAI_API_BASE=
MYAI_API_KEY=

# Only if swiss-grounding is switched to HTTP transport in config.yaml
SWISS_MCP_URL=
SWISS_MCP_TOKEN=
